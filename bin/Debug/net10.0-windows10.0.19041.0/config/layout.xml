<?xml version="1.0" encoding="utf-8"?>
<shell>
  <!--
    Компактная плавающая панель.
    Layout:
      [⊞] | [pins] ······ [time/date] | [✕]
  -->
  <bar id="main" class="bar" edge="bottom" height="48" margin="8">

    <button id="start" class="start" module="start">⊞</button>
    <separator class="divider"/>
    <pins/>

    <filler/>

    <panel orientation="vertical" class="clock-stack">
      <label id="clock" class="time" module="clock">--:--</label>
      <label id="date"  class="date" module="date">--.--</label>
    </panel>

    <separator class="divider"/>

    <button id="exit" class="exit" module="exit">✕</button>

  </bar>
</shell>